{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*", "DATABASE_URL", "DATABASE_MIGRATOR_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    }
  }
}
