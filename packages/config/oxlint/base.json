{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "eqeqeq": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@credalent/*/src/**",
              "@credalent/*/infrastructure/**",
              "@credalent/*/domain/**",
              "@credalent/*/application/**"
            ],
            "message": "Import a module only through its contracts entry @credalent/<m> (ADR-002)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**", "tools/**", "**/cli.ts"],
      "rules": { "no-console": "off" }
    }
  ]
}
