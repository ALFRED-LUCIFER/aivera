{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "promptVersion": {
      "type": "string",
      "pattern": "^[a-z][\\w.-]{0,63}@\\d{1,4}$"
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "tokenCap": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxOutputTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    }
  },
  "required": [
    "promptVersion",
    "system",
    "prompt",
    "tokenCap",
    "maxOutputTokens",
    "temperature"
  ],
  "additionalProperties": false
}
