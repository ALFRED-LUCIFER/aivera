{
  "name": "aivera",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @aivera/db exec node --env-file-if-exists=../../.env.local src/cli.ts generate",
    "db:migrate": "pnpm --filter @aivera/db exec node --env-file-if-exists=../../.env.local src/cli.ts migrate",
    "check:links": "node tools/check-links/check.mjs",
    "check:guard": "sh .claude/hooks/guard.test.sh"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
