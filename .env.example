# Names only, never values (AGENTS.md 1.11). Locally, copy to .env.local (untracked); in Azure, values come from Key Vault.

# Runtime (apps/web/src/server/env.ts validates these at start-up). APP_ENV: local | dev | pilot | prod
APP_ENV=
COMMIT_SHA=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# PostgreSQL (app role is subject to row-level security; migrator owns the schemas)
DATABASE_URL=
DATABASE_MIGRATOR_URL=

# Azure AI Foundry (packages/ai). Deployments per task are in packages/ai/src/config.ts. AI_PROVIDER=fake: tests, local and dev
AI_PROVIDER=
# With AI_PROVIDER=fake: a JSON file of canned answers by prompt text (the e2e tests' tests/e2e/ai-fixtures.json)
AI_FAKE_FIXTURES=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# Messaging and storage
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_STORAGE_ACCOUNT=

# Recruiter sign-in on Entra External ID (docs/runbooks/recruiter-sign-in.md); all or none. Secrets: Key Vault in Azure.
AUTH_SECRET=
AUTH_ENTRA_TENANT_SUBDOMAIN=
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=

# Candidate sign-in on the same tenant (docs/runbooks/candidate-sign-in.md); both or neither, and needs the five above.
AUTH_ENTRA_CANDIDATE_CLIENT_ID=
AUTH_ENTRA_CANDIDATE_CLIENT_SECRET=

# Recruiter "Continue with Google" straight to Google (AIV-P0-928, docs/runbooks/recruiter-sign-in.md); both or neither.
# Unset, the Google button is hidden.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Operator console /ops (docs/runbooks/operator-console.md): comma-separated emails; unset, empty or invalid lets nobody in.
PLATFORM_OPERATOR_EMAILS=

# Email
ACS_EMAIL_ENDPOINT=

# Stripe (candidate Plus)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitHub evidence reader
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
