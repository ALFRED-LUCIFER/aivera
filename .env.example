# Names only, never values (AGENTS.md 1.11). Locally, copy to .env.local (untracked); in Azure, values come from Key Vault.

# Runtime (apps/web/src/server/env.ts validates these at start-up). APP_ENV: local | dev | pilot | prod
APP_ENV=
COMMIT_SHA=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# PostgreSQL (app role is subject to row-level security; migrator owns the schemas)
DATABASE_URL=
DATABASE_MIGRATOR_URL=
# Worker only: the outbox relay's role, which reads every workspace's outbox and nothing else (AIV-P0-014)
RELAY_DATABASE_URL=
# Worker in Azure only: the relay identity's client id; the consumers use AZURE_CLIENT_ID (AIV-P0-015)
RELAY_CLIENT_ID=

# Azure AI Foundry (packages/ai). Deployments per task are in packages/ai/src/config.ts. AI_PROVIDER=fake: tests, local and dev
AI_PROVIDER=
# With AI_PROVIDER=fake: a JSON file of canned answers by prompt text (the e2e tests' tests/e2e/ai-fixtures.json)
AI_FAKE_FIXTURES=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# Messaging and storage
# Fully qualified, <name>.servicebus.windows.net; Entra sign-in only
AZURE_SERVICE_BUS_NAMESPACE=

# Email (AIV-P0-017). The send log's column key, base64 of 32 random bytes (`openssl rand -base64 32`): web and worker.
NOTIFICATIONS_ENCRYPTION_KEY=
# Worker: https://<resource>.communication.azure.com and the ACS sender address
ACS_ENDPOINT=
EMAIL_SENDER=
# Web: the key in the Event Grid delivery-report webhook URL (32+ characters); unset, the webhook answers 404
ACS_WEBHOOK_KEY=
# Web: the public origin for links in emails, e.g. http://localhost:3000 (AIV-P1-003); unset, invitations cannot be sent
AUTH_URL=
# Uploads (AIV-P0-016): the storage account's blob endpoint, https://<account>.blob.core.windows.net; unset, no upload or
# download is offered (web), and the worker settles no scan result. Signed in with AZURE_CLIENT_ID's identity.
AZURE_STORAGE_BLOB_URL=
# on | off (default on). off only where APP_ENV is local or dev: uploads are then marked clean without Defender's scan,
# after the server re-checks the blob's size and type. The pilot and production refuse to start with it off.
MALWARE_SCANNING=

# Recruiter sign-in on Entra External ID (docs/runbooks/recruiter-sign-in.md); all or none. Secrets: Key Vault in Azure.
AUTH_SECRET=
AUTH_ENTRA_TENANT_SUBDOMAIN=
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=

# Candidate sign-in on the same tenant (docs/runbooks/candidate-sign-in.md); both or neither, and needs the five above.
AUTH_ENTRA_CANDIDATE_CLIENT_ID=
AUTH_ENTRA_CANDIDATE_CLIENT_SECRET=

# Recruiter "Continue with Google" straight to Google (AIV-P0-928, docs/runbooks/recruiter-sign-in.md); both or neither.
# Unset, the Google button is hidden.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Operator console /ops (docs/runbooks/operator-console.md): comma-separated emails; unset, empty or invalid lets nobody in.
PLATFORM_OPERATOR_EMAILS=

# Email
ACS_EMAIL_ENDPOINT=

# Stripe (candidate Plus)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitHub evidence reader
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
