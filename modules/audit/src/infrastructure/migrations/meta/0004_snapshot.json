        },
        "entry_actor_id_check": {
          "name": "entry_actor_id_check",
          "value": "\"audit\".\"entry\".\"actor_type\" = 'system' or \"audit\".\"entry\".\"actor_id\" is not null"
        },
        "entry_action_check": {
          "name": "entry_action_check",
          "value": "\"audit\".\"entry\".\"action\" in ('rubric.approved', 'score.changed', 'candidate.merged', 'decision.recorded', 'assistant.confirmed', 'member.role_changed', 'workspace.created', 'workspace.type_changed', 'client.added', 'client.renamed', 'client.archived', 'job_access.granted', 'job_access.revoked')"
        },
        "entry_note_check": {
          "name": "entry_note_check",
          "value": "\"audit\".\"entry\".\"action\" not in ('score.changed', 'decision.recorded') or coalesce(btrim(\"audit\".\"entry\".\"note\"), '') <> ''"
