        "job_type_check": {
          "name": "job_type_check",
          "value": "\"jobs\".\"job\".\"job_type\" in ('software_engineering', 'qa_test_automation', 'ai_llm_engineering', 'forward_deployed_engineering', 'data_ml', 'devops_sre', 'product_management', 'product_design', 'sales', 'technical_writing_support')"
        },
        "job_stage_check": {
          "name": "job_stage_check",
          "value": "\"jobs\".\"job\".\"stage\" in ('defining_rubric', 'collecting_evidence', 'round_1', 'decision', 'closed')"
        },
        "job_pay_band_check": {
          "name": "job_pay_band_check",
          "value": "(\"jobs\".\"job\".\"pay_min_minor\" is null and \"jobs\".\"job\".\"pay_max_minor\" is null and \"jobs\".\"job\".\"pay_currency\" is null) or (0 <= \"jobs\".\"job\".\"pay_min_minor\" and \"jobs\".\"job\".\"pay_min_minor\" <= \"jobs\".\"job\".\"pay_max_minor\" and \"jobs\".\"job\".\"pay_currency\" ~ '^[A-Z]{3}$')"
        },
        "job_publication_check": {
          "name": "job_publication_check",
          "value": "not \"jobs\".\"job\".\"published\" or (coalesce(btrim(\"jobs\".\"job\".\"public_descriptor\"), '') <> '' and char_length(\"jobs\".\"job\".\"public_descriptor\") <= 80 and \"jobs\".\"job\".\"published_at\" is not null)"
        }
      },
