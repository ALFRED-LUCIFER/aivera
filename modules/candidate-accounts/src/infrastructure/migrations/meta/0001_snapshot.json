        "consent_text_version_check": {
          "name": "consent_text_version_check",
          "value": "btrim(\"candidate_accounts\".\"consent\".\"text_version\") <> ''"
        },
        "consent_target_check": {
          "name": "consent_target_check",
          "value": "case when \"candidate_accounts\".\"consent\".\"purpose\" = 'cv_check' then \"candidate_accounts\".\"consent\".\"workspace_id\" is null and \"candidate_accounts\".\"consent\".\"job_id\" is null else \"candidate_accounts\".\"consent\".\"workspace_id\" is not null and \"candidate_accounts\".\"consent\".\"job_id\" is not null end"
        },
        "consent_withdrawn_check": {
